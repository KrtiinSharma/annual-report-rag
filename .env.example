# Groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=
# any model starting with "claude" runs on the Anthropic API instead (the evaluation uses
# ANSWER_MODEL=claude-haiku-5-5)
ANSWER_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b
# RAGAS judge (evaluation only): Claude via the Anthropic API
JUDGE_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# LangSmith (free key: https://smith.langchain.com -> Settings -> API Keys)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=annual-report-analyst

# Retrieval
CHUNK_STRATEGY=structure

# API
ALLOWED_ORIGINS=http://localhost:5173
